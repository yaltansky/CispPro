{
    "Version": "1.0.0",
    "VersionUpdater": "1.0.0",
    "Urls": "http://*:80",
    "VirtualDirectories": {
        "Files": "/cispfiles"
    },
    "AppSettings": {
        "DeveloperEmail": "yaltansky@gmail.com",
        "SystemEmail": "cisportal@ruselprom.ru",
        "CompanyMailHost": "mail.ruselprom.ru",
        "HostName": "cisp.ruselprom.ru",
        "UseSendGrid": "false",
        "CompanyDefaultHelpDeskAnalyzerId": 800
    },
    "DbConnections": {
        "DefaultConnection": "postgre",
        "Connections": [
            {
                "ConnectionName": "postgre",
                "DatabaseType": "postgre",
                "ConnectionString": "Host=<PG_IP>;Database=cisp;Username=cisp;Password=XXX;Include Error Detail=True;"

            },
            {
                "ConnectionName": "postgre_shared",
                "DatabaseType": "postgre",
                "ConnectionString": "Host=<PG_IP>;Database=cisp_shared;Username=cisp;Password=XXX;Include Error Detail=True;"
            },
            {
                "ConnectionName": "mssql",
                "DatabaseType": "mssql",
                "ConnectionString": "Server=<MS_IP>;Database=cisp;user id=cisp;password=XXX;MultipleActiveResultSets=true;Encrypt=false"
            }
        ]
    },
    "ListenServer": {
        "ConnectionName": "postgre_shared",
        "Channels": [
            "qbroker_queue"
        ]
    },
    "DockerServer": {
        "Url": "unix:///var/run/docker.sock",
        "VersionMajor": 1,
        "VersionMinor": 44,
        "Install": [
            { "CmdName": "docker", "CmdArgs": "compose -f docker-compose.run.yml up -d" }
        ],
        "Uninstall": [
            { "CmdName": "bash", "CmdArgs": "uninstall.sh" }
        ],
        "PullImage": [
            { "CmdName": "docker", "CmdArgs": "pull @repository/@image" },
            { "CmdName": "docker", "CmdArgs": "compose -f docker-compose.run.yml up -d @image" }
        ],
        "Purge": [
            { "CmdName": "docker", "CmdArgs": "image rm $(docker images | grep none | awk '{print $3}')" }
        ]
    },
    "PatchInfo": {
        "FolderRoot": "./Patches"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
